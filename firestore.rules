rules_version = '2';

// ALISTO Firestore security rules.
//
// These apply ONLY to the Flutter app (client SDK, signed-in family members).
// The Raspberry Pi and the Flask website (admin / BHW) use the Admin SDK with
// a service account, which bypasses these rules entirely -- so nothing here
// affects them. Any collection not listed below is denied to the app by
// default (distress_phrase, voice_detection_log, alert_notification,
// sms_delivery_log, emergency_status_history, bhw_profile, app_settings...).
//
// Replaces the 30-day "test mode" rule (allow read, write: if request.time <
// timestamp.date(...)), which expired and locked the app out of everything.
//
// Known limit, by design of the current data model: any signed-in family
// account can read other elders' records, because links are stored under
// auto-generated IDs that rules can't look up. Tightening that needs
// deterministic link IDs (e.g. "<uid>_<elderId>") -- a later migration.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Accounts: each person reads/writes only their OWN doc, and can never
    // change their role. The website decides who is an admin/BHW from this
    // field, so a client must not be able to set it to anything but 'family'.
    match /user_account/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'family';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // Alerts are created by the Pi. The app may only read them, acknowledge
    // them, and hide them for itself (hidden_for) -- nothing else.
    match /emergency_alert/{alertId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acknowledged', 'acknowledged_by', 'acknowledged_at', 'hidden_for']);
    }

    // Devices are pre-seeded by the admin; the app claims, renames and
    // unregisters them (update) but never creates or deletes them.
    match /device/{serial} {
      allow read: if signedIn();
      allow update: if signedIn();
    }

    match /elder_profile/{elderId} {
      allow read, create, update: if signedIn();
    }

    match /family_elder_link/{linkId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.family_user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.family_user_id == request.auth.uid;
    }

    // Written by the Pi only.
    match /device_location/{locationId} {
      allow read: if signedIn();
    }

    match /emergency_contact/{contactId} {
      allow read, write: if signedIn();
    }

    match /medication_reminder/{reminderId} {
      allow read, write: if signedIn();
    }

    // ---- Care plan (subscription) ----
    // The plan and QR settings are what the family sees before paying;
    // only those two documents are readable (never a listing of app_settings).
    match /care_plan/{planId} {
      allow read: if signedIn();
    }

    match /app_settings/{settingId} {
      allow get: if signedIn()
        && (settingId == 'plan_qr_codes' || settingId == 'payment_methods');
    }

    match /subscription/{elderId} {
      allow read: if signedIn();
    }

    // A family member can send a new payment (always 'pending', GCash only,
    // a real plan length, a 13-digit reference) and read their OWN payments.
    // Only the admin (website) approves or rejects them.
    match /payment/{paymentId} {
      allow read: if signedIn() && resource.data.paid_by_user_id == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.paid_by_user_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.method == 'gcash'
        && request.resource.data.months in [1, 3, 6, 12]
        && request.resource.data.reference_no.matches('^[0-9]{13}$');
    }

    // One tiny document per GCash reference number: create-only, so the same
    // reference can never be submitted twice (not even by another account).
    match /payment_reference/{reference} {
      allow get: if signedIn();
      allow create: if signedIn()
        && reference.matches('^[0-9]{13}$')
        && request.resource.data.user_id == request.auth.uid;
    }

    // When a payment is submitted, the app opens the same 'pay_<id>' inbox
    // thread the website does, so the admin team is notified. Create-only,
    // and only for a payment thread the sender is part of.
    match /inbox_thread/{threadId} {
      allow create: if signedIn()
        && threadId.matches('pay_.*')
        && request.resource.data.type == 'care_plan'
        && request.resource.data.created_by == request.auth.uid
        && request.auth.uid in request.resource.data.participant_ids
        && 'admins' in request.resource.data.participant_ids;

      match /messages/{messageId} {
        allow create: if signedIn()
          && threadId.matches('pay_.*')
          && request.resource.data.sender_id == request.auth.uid
          && request.auth.uid in getAfter(
               /databases/$(database)/documents/inbox_thread/$(threadId)
             ).data.participant_ids;
      }
    }
  }
}
